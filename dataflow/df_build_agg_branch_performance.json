{
	"name": "df_build_agg_branch_performance",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_sqldb_nbi_dw",
						"type": "LinkedServiceReference"
					},
					"name": "srcTransactions"
				},
				{
					"linkedService": {
						"referenceName": "ls_sqldb_nbi_dw",
						"type": "LinkedServiceReference"
					},
					"name": "srcAccounts"
				},
				{
					"linkedService": {
						"referenceName": "ls_sqldb_nbi_dw",
						"type": "LinkedServiceReference"
					},
					"name": "srcLoans"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_sqldb_nbi_dw",
						"type": "LinkedServiceReference"
					},
					"name": "sinkAggBranchPerformance"
				}
			],
			"transformations": [
				{
					"name": "joinTxnAccounts"
				},
				{
					"name": "aggBranchPerformance"
				},
				{
					"name": "derivedBranchCols"
				},
				{
					"name": "joinWithLoans"
				}
			],
			"scriptLines": [
				"source(output(",
				"          transaction_id as string,",
				"          account_number as string,",
				"          transaction_date as date,",
				"          transaction_time as timestamp,",
				"          transaction_type as string,",
				"          transaction_mode as string,",
				"          category as string,",
				"          channel as string,",
				"          amount as decimal(14,2),",
				"          currency as string,",
				"          status as string,",
				"          beneficiary_account as string,",
				"          beneficiary_name as string,",
				"          reference_number as string,",
				"          narration as string,",
				"          balance_after_txn as decimal(14,2),",
				"          is_suspicious as boolean,",
				"          is_internal_transfer as boolean,",
				"          meta_device_id as string,",
				"          meta_ip_address as string,",
				"          meta_location_city as string,",
				"          meta_processing_bank as string,",
				"          meta_batch_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'fact_transactions',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> srcTransactions",
				"source(output(",
				"          account_number as string,",
				"          customer_id as string,",
				"          account_type as string,",
				"          branch_id as string,",
				"          open_date as date,",
				"          close_date as date,",
				"          status as string,",
				"          currency as string,",
				"          interest_rate as decimal(5,2),",
				"          is_joint_account as boolean,",
				"          minimum_balance as decimal(10,2),",
				"          nominee_name as string,",
				"          missing_nominee_flag as boolean,",
				"          account_age_years as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'dim_accounts',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> srcAccounts",
				"source(output(",
				"          loan_id as string,",
				"          customer_id as string,",
				"          loan_type as string,",
				"          branch_id as string,",
				"          sanction_date as date,",
				"          disbursement_date as date,",
				"          maturity_date as date,",
				"          principal_amount as decimal(14,2),",
				"          outstanding_amount as decimal(14,2),",
				"          interest_rate as decimal(5,2),",
				"          tenure_months as integer,",
				"          emi_amount as decimal(12,2),",
				"          emi_due_date as integer,",
				"          total_emis_paid as integer,",
				"          emis_overdue as integer,",
				"          overdue_category as string,",
				"          collateral_type as string,",
				"          collateral_value as decimal(14,2),",
				"          loan_status as string,",
				"          loan_officer_id as string,",
				"          is_npa as boolean,",
				"          insurance_linked_flag as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'fact_loans',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> srcLoans",
				"srcTransactions, srcAccounts join(srcTransactions@account_number == srcAccounts@account_number,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinTxnAccounts",
				"joinWithLoans aggregate(groupBy(srcAccounts@branch_id,",
				"          meta_location_city),",
				"     total_transactions = count(1),",
				"          total_transaction_value = sum(toDouble(amount)),",
				"          total_accounts_opened = countDistinct(srcAccounts@account_number),",
				"          total_active_accounts = sum(iif(srcAccounts@status == 'Active', 1, 0)),",
				"          total_loan_amount_disbursed = sum(toDouble(principal_amount)),",
				"          total_active_loans = sum(iif(loan_status == 'Active', 1, 0)),",
				"          total_npa_loans = sum(iif(is_npa == true(), 1, 0)),",
				"          avg_customer_credit_score = avg(toDouble(emi_amount))) ~> aggBranchPerformance",
				"aggBranchPerformance derive(report_date = currentDate()) ~> derivedBranchCols",
				"joinTxnAccounts, srcLoans join(srcAccounts@branch_id == srcLoans@branch_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinWithLoans",
				"derivedBranchCols sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'agg_branch_performance',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     truncate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          branch_id,",
				"          city = meta_location_city,",
				"          total_transactions,",
				"          total_transaction_value,",
				"          total_accounts_opened,",
				"          total_active_accounts,",
				"          total_loan_amount_disbursed,",
				"          total_active_loans,",
				"          total_npa_loans,",
				"          avg_customer_credit_score",
				"     )) ~> sinkAggBranchPerformance"
			]
		}
	}
}