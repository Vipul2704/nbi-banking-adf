{
	"name": "df_load_fact_transactions",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_blob_nbi_source",
						"type": "LinkedServiceReference"
					},
					"name": "srcTransactions"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_sqldb_nbi_dw",
						"type": "LinkedServiceReference"
					},
					"name": "sinkFactTransactions"
				}
			],
			"transformations": [
				{
					"name": "extractMetadata"
				},
				{
					"name": "selectTransactionCols"
				}
			],
			"scriptLines": [
				"source(output(",
				"          account_number as string,",
				"          amount as double,",
				"          balance_after_txn as double,",
				"          beneficiary_account as string,",
				"          beneficiary_name as string,",
				"          category as string,",
				"          channel as string,",
				"          currency as string,",
				"          is_suspicious as boolean,",
				"          metadata as (batch_id as string, device_id as string, ip_address as string, location_city as string, processing_bank as string),",
				"          narration as string,",
				"          reference_number as string,",
				"          status as string,",
				"          transaction_date as date,",
				"          transaction_id as string,",
				"          transaction_mode as string,",
				"          transaction_time as string,",
				"          transaction_type as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'json',",
				"     container: 'source-files',",
				"     fileName: 'bank_transactions.json',",
				"     documentForm: 'arrayOfDocuments') ~> srcTransactions",
				"srcTransactions derive(device_id = toString(metadata.device_id),",
				"          ip_address = toString(metadata.ip_address),",
				"          location_city = toString(metadata.location_city),",
				"          processing_bank = toString(metadata.processing_bank),",
				"          batch_id = toString(metadata.batch_id),",
				"          is_internal_transfer = iif(transaction_type == 'Internal Transfer', true(), false())) ~> extractMetadata",
				"extractMetadata select(mapColumn(",
				"          account_number,",
				"          amount,",
				"          balance_after_txn,",
				"          beneficiary_account,",
				"          beneficiary_name,",
				"          category,",
				"          channel,",
				"          currency,",
				"          is_suspicious,",
				"          narration,",
				"          reference_number,",
				"          status,",
				"          transaction_date,",
				"          transaction_id,",
				"          transaction_mode,",
				"          transaction_time,",
				"          transaction_type,",
				"          device_id,",
				"          ip_address,",
				"          location_city,",
				"          processing_bank,",
				"          batch_id,",
				"          is_internal_transfer",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectTransactionCols",
				"selectTransactionCols sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'fact_transactions',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     truncate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkFactTransactions"
			]
		}
	}
}