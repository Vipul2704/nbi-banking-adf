{
	"name": "df_load_fact_account_balances",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_blob_nbi_source",
						"type": "LinkedServiceReference"
					},
					"name": "srcAccounts"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_sqldb_nbi_dw",
						"type": "LinkedServiceReference"
					},
					"name": "sinkFactAccountBalances"
				}
			],
			"transformations": [
				{
					"name": "derivedBalanceCols"
				},
				{
					"name": "selectBalanceCols"
				}
			],
			"scriptLines": [
				"source(output(",
				"          account_number as string,",
				"          customer_id as string,",
				"          account_type as string,",
				"          branch_id as string,",
				"          open_date as date,",
				"          close_date as date,",
				"          status as string,",
				"          current_balance as double,",
				"          available_balance as double,",
				"          currency as string,",
				"          interest_rate as double,",
				"          nominee_name as string,",
				"          is_joint_account as boolean,",
				"          minimum_balance as short",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     container: 'source-files',",
				"     fileName: 'bank_accounts.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> srcAccounts",
				"srcAccounts derive(balance_date = currentDate(),",
				"          utilization_percent = iif(current_balance > 0, toDouble((current_balance - available_balance) / current_balance * 100), toDouble(0))) ~> derivedBalanceCols",
				"derivedBalanceCols select(mapColumn(",
				"          account_number,",
				"          customer_id,",
				"          current_balance,",
				"          available_balance,",
				"          currency,",
				"          minimum_balance,",
				"          balance_date,",
				"          utilization_percent",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectBalanceCols",
				"selectBalanceCols sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'fact_account_balances',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     truncate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkFactAccountBalances"
			]
		}
	}
}