{
	"name": "df_load_dim_loan_types",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "ls_blob_nbi_source",
						"type": "LinkedServiceReference"
					},
					"name": "srcLoans"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "ls_sqldb_nbi_dw",
						"type": "LinkedServiceReference"
					},
					"name": "sinkDimLoanTypes"
				}
			],
			"transformations": [
				{
					"name": "selLoanTypeCols"
				},
				{
					"name": "aggDistinctLoanTypes"
				}
			],
			"scriptLines": [
				"source(output(",
				"          branch_id as string,",
				"          collateral_type as string,",
				"          collateral_value as double,",
				"          customer_id as string,",
				"          disbursement_date as date,",
				"          emi_amount as double,",
				"          emi_due_date as short,",
				"          emis_overdue as short,",
				"          insurance_linked as boolean,",
				"          interest_rate as double,",
				"          is_npa as boolean,",
				"          loan_id as string,",
				"          loan_officer_id as string,",
				"          loan_status as string,",
				"          loan_type as string,",
				"          maturity_date as date,",
				"          outstanding_amount as double,",
				"          principal_amount as double,",
				"          sanction_date as date,",
				"          tenure_months as short,",
				"          total_emis_paid as short",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'json',",
				"     container: 'source-files',",
				"     fileName: 'bank_loans.json',",
				"     documentForm: 'arrayOfDocuments') ~> srcLoans",
				"srcLoans select(mapColumn(",
				"          interest_rate,",
				"          loan_type,",
				"          tenure_months",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selLoanTypeCols",
				"selLoanTypeCols aggregate(groupBy(loan_type),",
				"     avg_interest_rate = avg(interest_rate),",
				"          max_tenure_months = max(tenure_months)) ~> aggDistinctLoanTypes",
				"aggDistinctLoanTypes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'dim_loan_types',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     truncate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkDimLoanTypes"
			]
		}
	}
}