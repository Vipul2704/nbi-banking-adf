{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nbi-banking-dev"
		},
		"ls_blob_nbi_source_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "storage-connection-string"
		},
		"ls_keyvault_nbi_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-nbi-banking-adf.vault.azure.net/"
		},
		"ls_sqldb_nbi_dw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-nbi-banking-srv.database.windows.net"
		},
		"ls_sqldb_nbi_dw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-nbi-banking-dw"
		},
		"ls_sqldb_nbi_dw_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-nbi-banking-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_keyvault_nbi_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_keyvault_nbi_properties_typeProperties_baseUrl')]"
					},
					"ls_blob_nbi_source_properties_typeProperties_connectionString_secretName": {
						"value": "[parameters('ls_blob_nbi_source_properties_typeProperties_connectionString_secretName')]"
					},
					"ls_sqldb_nbi_dw_properties_typeProperties_server": {
						"value": "[parameters('ls_sqldb_nbi_dw_properties_typeProperties_server')]"
					},
					"ls_sqldb_nbi_dw_properties_typeProperties_database": {
						"value": "[parameters('ls_sqldb_nbi_dw_properties_typeProperties_database')]"
					},
					"ls_sqldb_nbi_dw_properties_typeProperties_userName": {
						"value": "[parameters('ls_sqldb_nbi_dw_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}