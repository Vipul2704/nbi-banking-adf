{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-nbi-banking-dev"
		},
		"ls_keyvault_nbi_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-nbi-banking-adf.vault.azure.net/"
		},
		"ls_blob_nbi_source_properties_typeProperties_connectionString_secretName": {
			"type": "string",
			"defaultValue": "storage-connection-string"
		},
		"ls_sqldb_nbi_dw_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-nbi-banking-srv.database.windows.net"
		},
		"ls_sqldb_nbi_dw_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-nbi-banking-dw"
		},
		"ls_sqldb_nbi_dw_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_keyvault_nbi')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('ls_keyvault_nbi_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_blob_nbi_source')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_keyvault_nbi",
							"type": "LinkedServiceReference"
						},
						"secretName": "[parameters('ls_blob_nbi_source_properties_typeProperties_connectionString_secretName')]"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_keyvault_nbi')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_sqldb_nbi_dw')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_sqldb_nbi_dw_properties_typeProperties_server')]",
					"database": "[parameters('ls_sqldb_nbi_dw_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_sqldb_nbi_dw_properties_typeProperties_userName')]",
					"password": {
						"type": "AzureKeyVaultSecret",
						"store": {
							"referenceName": "ls_keyvault_nbi",
							"type": "LinkedServiceReference"
						},
						"secretName": "sql-db-password",
						"secretVersion": "6582ddb3251d4d5a81fda12b3bcf8d31"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_keyvault_nbi')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_blob_csv_source')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_blob_nbi_source",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"fileName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": {
							"value": "@dataset().fileName",
							"type": "Expression"
						},
						"container": "source-files"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_blob_nbi_source')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_blob_json_source')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_blob_nbi_source",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"fileName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": {
							"value": "@dataset().fileName",
							"type": "Expression"
						},
						"container": "source-files"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_blob_nbi_source')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_sqldb_nbi_target')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_sqldb_nbi_dw",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"tableName": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"table": {
						"value": "@dataset().tableName",
						"type": "Expression"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_sqldb_nbi_dw')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_load_dim_accounts')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "ls_blob_nbi_source",
								"type": "LinkedServiceReference"
							},
							"name": "srcAccounts"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "ls_sqldb_nbi_dw",
								"type": "LinkedServiceReference"
							},
							"name": "sinkDimAccounts"
						}
					],
					"transformations": [
						{
							"name": "derivedAccountCols"
						}
					],
					"scriptLines": [
						"source(output(",
						"          account_number as string,",
						"          customer_id as string,",
						"          account_type as string,",
						"          branch_id as string,",
						"          open_date as date,",
						"          close_date as date,",
						"          status as string,",
						"          current_balance as double,",
						"          available_balance as double,",
						"          currency as string,",
						"          interest_rate as double,",
						"          nominee_name as string,",
						"          is_joint_account as boolean,",
						"          minimum_balance as short",
						"     ),",
						"     useSchema: false,",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'delimited',",
						"     container: 'source-files',",
						"     fileName: 'bank_accounts.csv',",
						"     columnDelimiter: ',',",
						"     escapeChar: '\\\\',",
						"     quoteChar: '\\\"',",
						"     columnNamesAsHeader: true) ~> srcAccounts",
						"srcAccounts derive(missing_nominee_flag = iif(isNull(nominee_name), 1, 0),",
						"          account_age_years = year(currentDate()) - year(open_date)) ~> derivedAccountCols",
						"derivedAccountCols sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'dim_accounts',",
						"     insertable: true,",
						"     updateable: false,",
						"     deletable: false,",
						"     upsertable: false,",
						"     truncate: true,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkDimAccounts"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_blob_nbi_source')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_sqldb_nbi_dw')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_load_dim_customers')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"linkedService": {
								"referenceName": "ls_blob_nbi_source",
								"type": "LinkedServiceReference"
							},
							"name": "srcCustomers"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "ls_sqldb_nbi_dw",
								"type": "LinkedServiceReference"
							},
							"name": "sinkDimCustomers"
						}
					],
					"transformations": [
						{
							"name": "filterActiveCustomers"
						},
						{
							"name": "selectCustomerCols"
						}
					],
					"scriptLines": [
						"source(output(",
						"          customer_id as string,",
						"          first_name as string,",
						"          last_name as string,",
						"          date_of_birth as date,",
						"          gender as string,",
						"          email as string,",
						"          mobile as long,",
						"          city as string,",
						"          state as string,",
						"          pincode as integer,",
						"          customer_type as string,",
						"          occupation as string,",
						"          annual_income as double,",
						"          kyc_status as string,",
						"          registration_date as date,",
						"          branch_id as string,",
						"          relationship_manager_id as string,",
						"          is_active as boolean,",
						"          pan_number as string,",
						"          credit_score as short",
						"     ),",
						"     useSchema: false,",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'delimited',",
						"     container: 'source-files',",
						"     fileName: 'bank_customers.csv',",
						"     columnDelimiter: ',',",
						"     escapeChar: '\\\\',",
						"     quoteChar: '\\\"',",
						"     columnNamesAsHeader: true) ~> srcCustomers",
						"srcCustomers filter(is_active == true()) ~> filterActiveCustomers",
						"filterActiveCustomers select(mapColumn(",
						"          customer_id,",
						"          first_name,",
						"          last_name,",
						"          date_of_birth,",
						"          gender,",
						"          email,",
						"          mobile,",
						"          city,",
						"          state,",
						"          pincode,",
						"          customer_type,",
						"          occupation,",
						"          annual_income,",
						"          kyc_status,",
						"          registration_date,",
						"          branch_id,",
						"          relationship_manager_id,",
						"          pan_number,",
						"          credit_score",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectCustomerCols",
						"selectCustomerCols sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'dim_customers',",
						"     insertable: true,",
						"     updateable: false,",
						"     deletable: false,",
						"     upsertable: false,",
						"     truncate: true,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkDimCustomers"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_blob_nbi_source')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_sqldb_nbi_dw')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_load_dimensions')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "df_load_dim_customers",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "set_inactive_customer_count",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.00:30:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "df_load_dim_customers",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"srcCustomers": {},
									"sinkDimCustomers": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					},
					{
						"name": "set_inactive_customer_count",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "inactive_customer_count",
							"value": 0
						}
					},
					{
						"name": "df_load_dim_accounts",
						"type": "ExecuteDataFlow",
						"dependsOn": [
							{
								"activity": "df_load_dim_customers",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataflow": {
								"referenceName": "df_load_dim_accounts",
								"type": "DataFlowReference",
								"parameters": {},
								"datasetParameters": {
									"srcAccounts": {},
									"sinkDimAccounts": {}
								}
							},
							"staging": {},
							"compute": {
								"coreCount": 8,
								"computeType": "General"
							},
							"traceLevel": "Fine"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"inactive_customer_count": {
						"type": "Integer",
						"defaultValue": 0
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/dataflows/df_load_dim_customers')]",
				"[concat(variables('factoryId'), '/dataflows/df_load_dim_accounts')]"
			]
		}
	]
}